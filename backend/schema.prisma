generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("SUPABASE_DB_URL")
}

model User {
  id         String   @id @default(uuid())
  fullName   String
  email      String   @unique
  password   String
  cvUrl      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

